<?xml version="1.0" encoding="UTF-8"?>
<!--
	PHPUnit 9.6: the WordPress test library does not run on PHPUnit 10 and later.
	`composer test` runs both suites, `composer test:unit` runs the unit suite without WordPress.
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="web/app/plugins/mb-real-estate/tests/bootstrap.php"
	cacheResultFile=".phpunit.cache/test-results"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	convertDeprecationsToExceptions="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">web/app/plugins/mb-real-estate/tests/Unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory suffix="Test.php">web/app/plugins/mb-real-estate/tests/Integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
