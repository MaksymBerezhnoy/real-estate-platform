					"color": "#E3E8EE"
				},
				{
					"slug": "silver",
					"name": "Silver: strong line, text on navy",
					"color": "#C9D2DC"
				},
				{
					"slug": "muted",
					"name": "Secondary text",
					"color": "#4B5868"
				},
				{
					"slug": "contrast",
					"name": "Navy: text and footer",
					"color": "#0F1B2D"
				},
				{
					"slug": "contrast-line",
