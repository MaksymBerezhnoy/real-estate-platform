					"size": "30px",
					"fluid": {
						"min": "24px",
						"max": "30px"
					}
				},
				{
					"slug": "x-huge",
					"name": "X-Huge",
					"size": "36px",
					"fluid": {
						"min": "28px",
						"max": "36px"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "60px",
					"fluid": {
						"min": "36px",
						"max": "60px"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "4px"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "12px"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "16px"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "20px"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "24px"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "32px"
				},
				{
					"slug": "80",
					"name": "8",
					"size": "40px"
				},
				{
					"slug": "90",
					"name": "9",
					"size": "48px"
				},
				{
					"slug": "100",
					"name": "10",
					"size": "clamp(40px, 5vw, 64px)"
				},
				{
					"slug": "110",
					"name": "11",
					"size": "clamp(56px, 7vw, 96px)"
				}
			]
