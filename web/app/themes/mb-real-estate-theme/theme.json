				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "15px",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "18px",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "20px",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "22px",
