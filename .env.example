# Copy this file to .env. The values below work as is with the DDEV setup from the README;
# on any other environment replace the database settings, the URL and the salts.

DB_NAME='db'
DB_USER='db'
DB_PASSWORD='db'
DB_HOST='db'
# DB_PREFIX='wp_'

WP_ENV='development'
# DDEV_PRIMARY_URL is set by DDEV inside the web container.
WP_HOME="${DDEV_PRIMARY_URL}"
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
