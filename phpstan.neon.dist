# WordPress function signatures and hook types come from szepeviktor/phpstan-wordpress,
# which phpstan/extension-installer registers automatically.
parameters:
    level: 5
    paths:
        - web/app/plugins/mb-real-estate
    excludePaths:
        analyseAndScan:
            - '*/vendor/*'
            - '*/node_modules/*'
            - '*/build/*'
